{
  "name": "clearflight",
  "version": "1.0.0",
  "private": true,
  "description": "Finds the windows birds are most likely to fly into, by tracing thousands of flights and what each pane reflects, then chooses the treatments that save the most birds for the budget",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 tests/engine/*.test.mjs",
    "test:web": "node --test --test-concurrency=1 tests/web/*.test.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@types/node": "22.15.3",
    "@types/three": "0.170.0",
    "playwright": "1.56.0",
    "three": "0.170.0",
    "typescript": "5.8.3"
  }
}
